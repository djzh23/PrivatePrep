		<Content Remove="Services\SkillGap\taxonomy-draft\*.json" />
		<EmbeddedResource Include="Services\SkillGap\skill-taxonomy.en.json">
			<LogicalName>PrivatePrep.Services.SkillGap.skill-taxonomy.en.json</LogicalName>
			<WithCulture>false</WithCulture>
		</EmbeddedResource>
		<EmbeddedResource Include="Services\SkillGap\taxonomy-draft\*.json" />
		<EmbeddedResource Include="Services\Agent\Prompts\analyze-system-prompt.md">
			<LogicalName>PrivatePrep.Services.Agent.Prompts.analyze-system-prompt.md</LogicalName>
		</EmbeddedResource>
