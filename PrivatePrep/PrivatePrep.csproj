		<EmbeddedResource Include="Services\Tariffs\Data\tv-l.json">
			<LogicalName>PrivatePrep.Services.Tariffs.Data.tv-l.json</LogicalName>
			<WithCulture>false</WithCulture>
		</EmbeddedResource>
